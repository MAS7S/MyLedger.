rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // accessOwners/{uid}: assigned by the Firebase administrator only.
    // accessInvites/{lowercaseEmail}: owner-managed {allowed: true}.
    // users/{uid}/ledger/current: bounded JSON payload and integer revision.
    function hasVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider in ['google.com', 'password'];
    }

    function isOwner() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/accessOwners/$(request.auth.uid));
    }

    function isInvited(email) {
      return exists(/databases/$(database)/documents/accessInvites/$(email))
        && get(/databases/$(database)/documents/accessInvites/$(email)).data.allowed == true;
    }

    function canUseLedger(uid) {
      return request.auth != null && request.auth.uid == uid
        && (isOwner() || (hasVerifiedEmail()
          && isInvited(request.auth.token.email.lower())));
    }

    function isValidInvite(email, invite) {
      return email.size() <= 254
        && email == email.lower()
        && email.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$')
        && invite.keys().hasOnly(['allowed'])
        && invite.allowed == true;
    }

    function isValidLedger(ledger) {
      return ledger.keys().hasAll(['revision', 'payload'])
        && ledger.keys().hasOnly(['revision', 'payload'])
        && ledger.revision is int
        && ledger.payload is string
        && ledger.payload.size() > 0
        && ledger.payload.size() <= 700000;
    }

    // A missing document is readable only when the exact address is approved.
    // No invitation or owner records are returned by this lookup.
    match /signupChecks/{email} {
      allow get: if resource == null
        && email.size() <= 254 && email == email.lower()
        && email.matches('^[^@/ ]+@[^@/ ]+[.][^@/ ]+$')
        && (request.auth == null || hasMatchingEmail(email))
        && (isInvited(email) || isRegisteredOwnerEmail(email)
          || (hasMatchingEmail(email)
            && exists(/databases/$(database)/documents/accessOwners/$(request.auth.uid))));
    }

    function hasMatchingEmail(email) {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email.lower() == email;
    }

    function isRegisteredOwnerEmail(email) {
      let path = /databases/$(database)/documents/accessOwnerEmails/$(email);
      return exists(path)
        && exists(/databases/$(database)/documents/accessOwners/$(get(path).data.uid));
    }

    function isValidOwnerEmail(email, entry) {
      return isOwner() && hasMatchingEmail(email)
        && entry.keys().hasOnly(['uid']) && entry.uid == request.auth.uid;
    }

    match /accessOwnerEmails/{email} {
      allow create, update: if isValidOwnerEmail(email, request.resource.data);
    }

    match /accessOwners/{uid} {
      allow get: if hasVerifiedEmail() && request.auth.uid == uid;
    }

    match /accessInvites/{email} {
      allow list: if isOwner();
      allow delete: if isOwner();
      allow get: if isOwner()
        || (hasVerifiedEmail() && request.auth.token.email.lower() == email);
      allow create, update: if isOwner() && isValidInvite(email, request.resource.data)
        && !exists(/databases/$(database)/documents/accessRevocations/$(email));
    }

    // Only the Worker service account can write deletion progress via IAM.
    match /accessRevocations/{email} {
      allow get, list: if isOwner();
    }

    // Old signup links are closed. Owners may remove the old record when modifying a grant.
    match /signupInvites/{code} {
      allow delete: if isOwner();
    }

    match /users/{uid}/ledger/current {
      allow get: if canUseLedger(uid);
      allow create: if canUseLedger(uid)
        && isValidLedger(request.resource.data)
        && request.resource.data.revision == 1;
      allow update: if canUseLedger(uid)
        && isValidLedger(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}

